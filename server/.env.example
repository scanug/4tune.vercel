# Porta di ascolto (Railway la imposta automaticamente)
PORT=4000
# Origin ammessi per CORS e Socket.IO, separati da virgola. Vuoto = tutti (solo sviluppo).
CLIENT_ORIGIN=http://localhost:3000
# Codice per la gestione del catalogo di Completa la barra (/barra/admin). Vuoto = gestione spenta.
ADMIN_TOKEN=
# Facoltativa: ricerca testi Musixmatch nella gestione di Completa la barra
MUSIXMATCH_API_KEY=
